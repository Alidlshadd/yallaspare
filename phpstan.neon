includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 3 cost one ignore entry: six of its seven findings were PHPDoc that
    # misdescribed the values underneath it, so the annotations were corrected
    # rather than suppressed. Level 2 before it went 110 -> 0 with 101 closed
    # in code. The eleven entries under ignoreErrors are each pinned to a file
    # with an exact count.
    #
    # Level 4 sits at 90 and is a different kind of work — it reports
    # unreachable branches and always-true conditions, so each finding needs
    # reading rather than a mechanical fix.
    #
    # Do not add reportUnmatched: false to new entries without checking first:
    # it is only needed when a rule fires above the enforced level, and a stale
    # one hides an ignore that has stopped matching.
    level: 3

    paths:
        - app
        - config
        - database
        - routes

    # Generated, vendored, or tool-written. Nobody edits these by hand, and
    # compiled Blade in storage/framework/views would report on template output
    # rather than on the templates themselves.
    excludePaths:
        analyseAndScan:
            - bootstrap/cache
            - storage
            - public
            - vendor
            # (?) marks it optional: the static analysis CI job never runs
            # npm ci, and PHPStan treats a missing excludePath as an error.
            - node_modules (?)

    ignoreErrors:
        # AdminSeeder reads ADMIN_EMAIL/NAME/PASSWORD through env() on purpose.
        # Moving it to config() would break AdminSeederTest, which drives those
        # values with putenv() to exercise the seeder's own fallbacks. The
        # failure mode under a cached config is that the seeder skips with a
        # warning rather than creating a weak admin, so this is worth leaving
        # until the seeder and its test are reworked together.
        -
            message: "#Called 'env' outside of the config directory#"
            path: database/seeders/AdminSeeder.php

        # The suggested rewrite is wrong here: the query groups by product_id
        # and filters with HAVING, so ->count() on the builder would count rows
        # per group instead of counting the groups. Collecting and counting is
        # the correct read.
        -
            message: "#Called 'count' on Laravel collection, but could have been retrieved as a query#"
            path: app/Http/Controllers/Admin/OperationsInsightController.php

        # products.created_by is genuinely optional — no migration creates it —
        # and the dealer ownership check reads it only behind
        # Schema::hasColumn('products', 'created_by'), which short-circuits
        # before the property is touched. Declaring @property-read on Product
        # would be the wrong fix: it would claim a column the schema does not
        # guarantee and mask real typos everywhere else.
        # count: 1 keeps this scoped to the guarded read; a second, unguarded
        # one elsewhere in the file would still be reported.
        -
            message: '#Access to an undefined property App\\Models\\Product::\$created_by#'
            path: app/Http/Controllers/Api/MobileController.php
            count: 1

        # The two below share one shape: the method is real but declared on the
        # concrete class rather than the interface the call site sees. Verified
        # in vendor, not assumed.

        # stateless() lives on Laravel\Socialite\Two\AbstractProvider, not on
        # the Provider contract that Socialite::driver() is typed to return.
        # The Apple provider extends that class, so the call resolves.
        -
            message: '#Call to an undefined method Laravel\\Socialite\\Contracts\\Provider::stateless\(\)#'
            path: app/Http/Controllers/Auth/SocialAuthController.php
            count: 2

        # Same contract, same gap: Provider::redirect() is documented as
        # returning Symfony's RedirectResponse or Illuminate's, so PHPStan
        # takes the union. Every provider actually in use extends
        # Two\AbstractProvider, whose redirect() constructs Illuminate's, so
        # the declared return type on this method holds at runtime.
        -
            message: '#redirectToGoogle\(\) should return Illuminate\\Http\\RedirectResponse but returns Symfony\\Component\\HttpFoundation\\RedirectResponse#'
            path: app/Http/Controllers/Auth/SocialAuthController.php
            count: 1

        # getQueryGrammar() is on Illuminate\Database\Connection, not on the
        # ConnectionInterface that getConnection() advertises. Every connection
        # Laravel builds extends that class.
        -
            message: '#Call to an undefined method Illuminate\\Database\\ConnectionInterface::getQueryGrammar\(\)#'
            path: app/Support/SqlSafe.php
            count: 1

        # The three below read aggregate columns that exist only on the rows a
        # specific query returns — selectRaw aliases and joined subquery
        # columns. Each was traced to the select that produces it, and each
        # read is cast, so a missing alias would surface as 0 rather than an
        # error. @property-read on the model would be wrong: the column exists
        # for one query, not for the model, and declaring it would hide typos
        # in every other read.
        # Counts pin each entry to its known reads. The proper fix is a result
        # object per query rather than reading aggregates off the model, which
        # is a refactor rather than an annotation.

        # DashboardController: DB::raw('... as month') and 'COUNT(*) as total'.
        -
            message: '#Access to an undefined property App\\Models\\Order::\$(month|total)#'
            path: app/Http/Controllers/Admin/DashboardController.php
            count: 2

        # OperationsInsightController: sales.sold_quantity and
        # waiting.waiting_count, both joined in as subquery aggregates.
        -
            message: '#Access to an undefined property App\\Models\\Product::\$(sold_quantity|waiting_count)#'
            path: app/Http/Controllers/Admin/OperationsInsightController.php
            count: 3

        # AdminActivityLogController: selectRaw('count(*) as aggregate').
        -
            message: '#Access to an undefined property Spatie\\Activitylog\\Models\\Activity::\$aggregate#'
            path: app/Http/Controllers/Admin/AdminActivityLogController.php
            count: 1

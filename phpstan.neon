includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 1 costs nothing to enforce: typing the Eloquent relations cleared
    # both levels at once, so this went from 105 errors to zero without a
    # dedicated pass.
    #
    # Level 2 is the next step and sits at 111. Nearly all of it (88) is the
    # relation types missing their generic parameters — BelongsTo<Product,
    # $this> rather than a bare BelongsTo — which drops the concrete model back
    # to the base class. Measured, not guessed: adding generics to one model
    # took the count to 109. The rest is 9 no-op after() calls in already-run
    # migrations, 7 query aliases PHPStan cannot see, 4 framework false
    # positives and 2 undeclared accessors.
    level: 1

    paths:
        - app
        - config
        - database
        - routes

    # Generated, vendored, or tool-written. Nobody edits these by hand, and
    # compiled Blade in storage/framework/views would report on template output
    # rather than on the templates themselves.
    excludePaths:
        analyseAndScan:
            - bootstrap/cache
            - storage
            - public
            - vendor
            # (?) marks it optional: the static analysis CI job never runs
            # npm ci, and PHPStan treats a missing excludePath as an error.
            - node_modules (?)

    ignoreErrors:
        # AdminSeeder reads ADMIN_EMAIL/NAME/PASSWORD through env() on purpose.
        # Moving it to config() would break AdminSeederTest, which drives those
        # values with putenv() to exercise the seeder's own fallbacks. The
        # failure mode under a cached config is that the seeder skips with a
        # warning rather than creating a weak admin, so this is worth leaving
        # until the seeder and its test are reworked together.
        -
            message: "#Called 'env' outside of the config directory#"
            path: database/seeders/AdminSeeder.php

        # The suggested rewrite is wrong here: the query groups by product_id
        # and filters with HAVING, so ->count() on the builder would count rows
        # per group instead of counting the groups. Collecting and counting is
        # the correct read.
        -
            message: "#Called 'count' on Laravel collection, but could have been retrieved as a query#"
            path: app/Http/Controllers/Admin/OperationsInsightController.php

        # products.created_by is genuinely optional — no migration creates it —
        # and the dealer ownership check reads it only behind
        # Schema::hasColumn('products', 'created_by'), which short-circuits
        # before the property is touched. Declaring @property-read on Product
        # would be the wrong fix: it would claim a column the schema does not
        # guarantee and mask real typos everywhere else.
        # count: 1 keeps this scoped to the guarded read; a second, unguarded
        # one elsewhere in the file would still be reported.
        # reportUnmatched: false because the rule that raises this only runs
        # from level 2, while CI currently enforces level 1 — without it the
        # entry itself is reported as unmatched and fails the build.
        -
            message: '#Access to an undefined property App\\Models\\Product::\$created_by#'
            path: app/Http/Controllers/Api/MobileController.php
            count: 1
            reportUnmatched: false

        # The three below share one shape: the method is real but declared on
        # the concrete class rather than the interface the call site sees.
        # Verified in vendor, not assumed. All are level 2 rules while CI
        # enforces level 1, so each needs reportUnmatched: false — without it
        # the entry is reported as unmatched and fails the build.

        # stateless() lives on Laravel\Socialite\Two\AbstractProvider, not on
        # the Provider contract that Socialite::driver() is typed to return.
        # The Apple provider extends that class, so the call resolves.
        -
            message: '#Call to an undefined method Laravel\\Socialite\\Contracts\\Provider::stateless\(\)#'
            path: app/Http/Controllers/Auth/SocialAuthController.php
            count: 2
            reportUnmatched: false

        # getQueryGrammar() is on Illuminate\Database\Connection, not on the
        # ConnectionInterface that getConnection() advertises. Every connection
        # Laravel builds extends that class.
        -
            message: '#Call to an undefined method Illuminate\\Database\\ConnectionInterface::getQueryGrammar\(\)#'
            path: app/Support/SqlSafe.php
            count: 1
            reportUnmatched: false

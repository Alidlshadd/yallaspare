##
# YallaSpare static asset performance snippet.
# Include this inside the HTTPS server block for yallaspare.com, alongside
# yallaspare-upload-hardening.conf.example.
#
# Measured on 2026-09-05 against the live site, this snippet was NOT in effect:
# every response for /build and /storage came back with no Cache-Control and no
# Content-Encoding, so each page view re-downloaded the whole asset set
# uncompressed (290KB CSS + 161KB JS before a single image).
##

# --- Compression -----------------------------------------------------------
# Text assets are the ones paid for on every single page view. The CSS bundle
# alone drops from ~290KB to ~48KB, the JS from ~161KB to ~52KB.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types
    text/plain
    text/css
    text/javascript
    application/javascript
    application/json
    application/xml
    application/rss+xml
    image/svg+xml
    font/woff
    font/woff2;

# Never compress what is already compressed: images, video and woff2 carry
# their own compression, and gzipping them only burns CPU.

# --- Vite build output -----------------------------------------------------
# Every filename here carries a content hash, so a changed file is a changed
# URL. That makes an immutable year-long cache safe: the browser can reuse the
# bundle forever and still pick up the next deploy instantly.
location ^~ /build/ {
    access_log off;
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
}

# --- Uploaded media --------------------------------------------------------
# Product photos and hero media are not content-hashed, so they get a shorter
# window than the build output. A replaced image is visible within the day.
location ^~ /storage/ {
    alias /var/www/yallaspare/public/storage/;
    access_log off;
    expires 7d;
    add_header Cache-Control "public, max-age=604800";

    # Uploaded media must never be executed.
    location ~ \.php(?:/|$) {
        return 404;
    }
}

# --- Static files served straight from public/ -----------------------------
location ~* \.(?:ico|png|jpe?g|gif|webp|avif|svg|woff2?|ttf|eot|mp4|webm)$ {
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000";
}
